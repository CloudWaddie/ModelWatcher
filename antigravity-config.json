{
  "webhook": {
    "enabled": true,
    "webhookEnv": "TOMBSTONE_WEBHOOK"
  },
  "stateFile": "./logs/antigravity-web-state.json",
  "maxItemsPerSection": 25,
  "cli": {
    "manifestBase": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app",
    "platforms": [
      "linux_amd64",
      "linux_arm64",
      "linux_amd64_musl",
      "linux_arm64_musl",
      "darwin_amd64",
      "darwin_arm64",
      "windows_amd64",
      "windows_arm64",
      "android_arm64"
    ]
  },
  "downloadPage": "https://antigravity.google/download",
  "vscode": {
    "itemName": "Google.google-antigravity"
  },
  "analyze": {
    "cli": true,
    "vsix": true
  },
  "docs": {
    "base": "https://antigravity.google",
    "llms": "/llms.txt",
    "rss": "/blog/rss.xml"
  },
  "web": {
    "pages": [],
    "sitemaps": [
      {
        "id": "antigravity.google",
        "url": "https://antigravity.google/sitemap.xml"
      }
    ]
  },
  "md": {
    "base": "https://antigravity.google",
    "models": "/docs/models.md",
    "changelog": "/docs/changelog.md",
    "pages": [
      {
        "id": "plans",
        "path": "/docs/plans.md"
      },
      {
        "id": "cli-reference",
        "path": "/docs/cli/reference.md"
      },
      {
        "id": "enterprise",
        "path": "/docs/enterprise.md"
      },
      {
        "id": "faq",
        "path": "/docs/faq.md"
      },
      {
        "id": "cli-credits",
        "path": "/docs/cli/credits.md"
      }
    ]
  }
}
